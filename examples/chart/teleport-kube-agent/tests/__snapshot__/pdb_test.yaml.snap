should create a PDB when enabled in values (pdb.yaml):
  1: |
    apiVersion: policy/v1beta1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app: RELEASE-NAME
      name: RELEASE-NAME
      namespace: NAMESPACE
    spec:
      minAvailable: 2
      selector:
        matchLabels:
          app: RELEASE-NAME
      unhealthyPodEvictionPolicy: AlwaysAllow
