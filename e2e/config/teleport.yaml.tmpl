{{- /*gotype: github.com/gravitational/teleport/e2e/runner.TeleportConfig */ -}}
version: v3
teleport:
  nodename: {{ .ClusterName }}
  auth_token: foo
  data_dir: {{ .DataDir }}
  log:
    output: stderr
    severity: {{ .LogLevel }}
    format:
      output: text
  auth_server: localhost:{{ .AuthServerPort }}

auth_service:
  enabled: "yes"
  listen_addr: 0.0.0.0:{{ .AuthServerPort }}
  proxy_listener_mode: multiplex
  cluster_name: {{ .ClusterName }}
  tokens:
    - "node,auth,proxy,db,trusted_cluster:foo"
{{- if .LicenseFile }}
  license_file: {{ .LicenseFile }}
{{- end }}
  authentication:
    type: local
    second_factors: ["webauthn"]
    webauthn:
      rp_id: "localhost"

ssh_service:
  enabled: "no"

proxy_service:
  enabled: "yes"
  # The web API's rate limiter buckets by client IP, so without this the whole run shares one bucket.
  trust_x_forwarded_for: true
  # The tests claim IPv6 addresses, and the proxy signs a PROXY header pairing that source with the destination
  # of the connection it arrived on. That destination is whatever `localhost` resolves to, which is ::1 on some
  # machines and 127.0.0.1 in CI containers. Downgrading covers the IPv4 case; signing would reject it outright.
  proxy_protocol_allow_downgrade: true
  public_addr: localhost:{{ .ProxyPort }}
  acme: {}
  web_listen_addr: 0.0.0.0:{{ .ProxyPort }}
  https_keypairs:
    - key_file: {{ .KeyFilePath }}
      cert_file: {{ .CertFilePath }}
