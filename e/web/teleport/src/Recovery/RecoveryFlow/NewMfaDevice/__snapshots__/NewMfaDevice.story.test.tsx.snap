}

.c15 .react-select--is-disabled .react-select__indicator,
.c15 .react-select__control--is-disabled .react-select__indicator {
  color: rgba(255,255,255,0.36);
}

.c15 .react-select__input {
  color: #FFFFFF;
}

.c2 {
