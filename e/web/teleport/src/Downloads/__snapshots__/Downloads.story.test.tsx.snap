.c29>thead>tr>th,
.c29>tbody>tr>th,
.c29>tfoot>tr>th,
.c29>thead>tr>td,
.c29>tbody>tr>td,
.c29>tfoot>tr>td {
  padding: 8px 8px;
  vertical-align: middle;
}

.c29>thead>tr>th:first-child,
.c29>tbody>tr>th:first-child,
.c29>tfoot>tr>th:first-child,
.c29>thead>tr>td:first-child,
.c29>tbody>tr>td:first-child,
