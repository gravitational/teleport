{
    "compilerOptions": {
        "jsx": "react",
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "*": [
                "*",
                "src/*",
                "telebase/app/*"                
            ],
            "telebase-app/*": ["telebase/app/*"]
        }
    },
    "include": [
        "src/**/*"        
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}